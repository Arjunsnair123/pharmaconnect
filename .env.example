# Copy to .env and fill in. Never commit .env.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True only for local development.
DJANGO_DEBUG=False

# Comma-separated hostnames this site may serve (required when DEBUG is False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset for SQLite (db.sqlite3); set for PostgreSQL.
# DATABASE_URL=postgres://pharmaconnect:password@localhost:5432/pharmaconnect

# Search radius for location endpoints, in km.
# DEFAULT_SEARCH_RADIUS_KM=50
# MAX_SEARCH_RADIUS_KM=500

# Seconds to cache restock suggestions.
# RESTOCK_CACHE_TIMEOUT=900

# Where `manage.py train_demand_model` saves the model (default: ml/demand_model.joblib).
# DEMAND_MODEL_PATH=

# Either allow every origin (dev only) or list the allowed ones, comma-separated.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
